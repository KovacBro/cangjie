{
  "carrier_pool": "auto",
  "min_gain": 1.5,
  "encoding": "o200k_base",
  "max_entries": 128,
  "min_freq": 3,
  "min_phrase_cost": 3.0,
  "min_len_cjk": 2,
  "min_len_latin": 2,
  "max_ngram_cjk": 10,
  "max_ngram_latin": 4,
  "max_phrase_chars": 28,
  "min_freedom": 0.9,
  "min_cohesion": 2.0,
  "docs_gate": true,
  "allow_digits": false,
  "skip_code_only": true,
  "amortization": 1.0,
  "protect_code": true,
  "strict_escape": true,
  "scan_exts": [
    ".md",
    ".txt",
    ".py",
    ".js",
    ".ts",
    ".tsx",
    ".jsx",
    ".vue",
    ".json",
    ".yaml",
    ".yml",
    ".toml",
    ".ini",
    ".cfg",
    ".html",
    ".css",
    ".scss",
    ".sql",
    ".sh",
    ".ps1",
    ".java",
    ".go",
    ".rs",
    ".c",
    ".h",
    ".cpp",
    ".cs",
    ".rb",
    ".php",
    ".kt",
    ".swift",
    ".lua",
    ".proto",
    ".gradle"
  ],
  "max_file_bytes": 524288,
  "chunk_chars": 20000
}